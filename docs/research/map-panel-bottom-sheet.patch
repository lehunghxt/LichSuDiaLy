@@ -0,0 +1,57 @@
+import { fireEvent, render, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { useState } from 'react'
+import { MapSheet, nearestSnap, snapHeight, type Snap } from './MapSheet'
+
+function Harness({ initial = 'half' as Snap }) {
+  const [snap, setSnap] = useState<Snap>(initial)
+  return (
+    <MapSheet snap={snap} onSnap={setSnap}>
+      <p>Nội dung</p>
+    </MapSheet>
+  )
+}
+
+const sheet = () => screen.getByRole('complementary', { name: 'Thông tin bản đồ' })
+const handle = () => screen.getByRole('button', { name: /Kéo hoặc bấm/ })
+
+test('snap heights: peek shows only the top, half is about half the screen, full leaves the top strip visible', () => {
+  expect(snapHeight('peek', 800)).toBe(112)
+  expect(snapHeight('half', 800)).toBe(416)
+  expect(snapHeight('full', 800)).toBe(752)
+})
+
+test('nearestSnap picks the closest resting height after a drag', () => {
+  expect(nearestSnap(150, 800)).toBe('peek')
+  expect(nearestSnap(380, 800)).toBe('half')
+  expect(nearestSnap(700, 800)).toBe('full')
+})
+
+test('the sheet keeps its children, starts at its snap and tapping the handle toggles half ↔ full', async () => {
+  render(<Harness />)
+  expect(screen.getByText('Nội dung')).toBeInTheDocument()
+  expect(sheet()).toHaveAttribute('data-snap', 'half')
+  expect(handle()).toHaveAttribute('aria-expanded', 'false')
+  await userEvent.click(handle())
+  expect(sheet()).toHaveAttribute('data-snap', 'full')
+  expect(handle()).toHaveAttribute('aria-expanded', 'true')
+  await userEvent.click(handle())
+  expect(sheet()).toHaveAttribute('data-snap', 'half')
+})
+
+test('from peek, a tap opens to half', async () => {
+  render(<Harness initial="peek" />)
+  await userEvent.click(handle())
+  expect(sheet()).toHaveAttribute('data-snap', 'half')
+})
+
+test('dragging the handle down then releasing snaps to the nearest height (and is not also a tap)', () => {
+  window.innerHeight = 800
+  render(<Harness />)
+  fireEvent.pointerDown(handle(), { clientY: 400, pointerId: 1 })
+  fireEvent.pointerMove(handle(), { clientY: 650, pointerId: 1 })
+  expect(sheet().style.getPropertyValue('--sheet-h')).toBe('166px')
+  fireEvent.pointerUp(handle(), { clientY: 650, pointerId: 1 })
+  fireEvent.click(handle())
+  expect(sheet()).toHaveAttribute('data-snap', 'peek')
+})
diff --git a/src/features/map/MapSheet.tsx b/src/features/map/MapSheet.tsx
new file mode 100644
index 0000000..916a6af
--- /dev/null
+++ b/src/features/map/MapSheet.tsx
@@ -0,0 +1,100 @@
+import { type CSSProperties, type PointerEvent, type ReactNode, useRef, useState } from 'react'
+import { HALF_SHEET } from './fit'
+
+export type Snap = 'peek' | 'half' | 'full'
+
+// Thu gọn: chỉ thấy thanh kéo và thanh điều hướng; mở hết: vẫn chừa dải chip các vùng ở trên
+const PEEK = 112
+const TOP_GAP = 48
+const SNAPS: Snap[] = ['peek', 'half', 'full']
+
+/** Chiều cao (px) của tấm ở từng mức, theo chiều cao màn hình */
+export function snapHeight(snap: Snap, viewportHeight: number): number {
+  if (snap === 'peek') return PEEK
+  if (snap === 'half') return Math.round(viewportHeight * HALF_SHEET)
+  return viewportHeight - TOP_GAP
+}
+
+/** Mức gần nhất với chiều cao lúc thả tay */
+export function nearestSnap(height: number, viewportHeight: number): Snap {
+  const dist = (s: Snap) => Math.abs(snapHeight(s, viewportHeight) - height)
+  return SNAPS.reduce((a, b) => (dist(b) < dist(a) ? b : a))
+}
+
+// Chiều cao theo CSS (dvh) để tự đúng khi xoay màn hình hay thanh địa chỉ co giãn
+const SNAP_CSS: Record<Snap, string> = {
+  peek: `${PEEK}px`,
+  half: `${HALF_SHEET * 100}dvh`,
+  full: `calc(100dvh - ${TOP_GAP}px)`,
+}
+export const sheetCss = (snap: Snap) => SNAP_CSS[snap]
+
+interface MapSheetProps {
+  snap: Snap
+  onSnap(snap: Snap): void
+  children: ReactNode
+}
+
+/** Màn hẹp (dưới lg): khung thông tin là tấm kéo từ đáy, nổi trên bản đồ toàn màn hình.
+ *  Kéo thanh ở đầu tấm để đổi mức, thả tay thì bám mức gần nhất; bấm (hoặc Enter) để chuyển nửa ↔ gần hết.
+ *  Màn rộng: là cột bên phải như cũ. */
+export function MapSheet({ snap, onSnap, children }: MapSheetProps) {
+  const [dragHeight, setDragHeight] = useState<number | null>(null)
+  const drag = useRef<{ y: number; h: number; moved: boolean } | null>(null)
+  // Sau một lần kéo, trình duyệt vẫn bắn sự kiện click: bỏ qua để không bị tính thêm một lần bấm
+  const swallowClick = useRef(false)
+
+  const onPointerDown = (e: PointerEvent<HTMLButtonElement>) => {
+    e.currentTarget.setPointerCapture?.(e.pointerId)
+    drag.current = { y: e.clientY, h: snapHeight(snap, window.innerHeight), moved: false }
+  }
+  const onPointerMove = (e: PointerEvent<HTMLButtonElement>) => {
+    const d = drag.current
+    if (!d) return
+    const dy = d.y - e.clientY
+    if (Math.abs(dy) > 4) d.moved = true
+    if (d.moved) setDragHeight(Math.min(Math.max(d.h + dy, PEEK), window.innerHeight - TOP_GAP))
+  }
+  const onPointerUp = () => {
+    const d = drag.current
+    drag.current = null
+    if (!d?.moved || dragHeight === null) return
+    swallowClick.current = true
+    onSnap(nearestSnap(dragHeight, window.innerHeight))
+    setDragHeight(null)
+  }
+  const onClick = () => {
+    if (swallowClick.current) {
+      swallowClick.current = false
+      return
+    }
+    onSnap(snap === 'half' ? 'full' : 'half')
+  }
+
+  const style = { '--sheet-h': dragHeight === null ? SNAP_CSS[snap] : `${dragHeight}px` } as CSSProperties
+  return (
+    <aside
+      aria-label="Thông tin bản đồ"
+      data-snap={snap}
+      style={style}
+      className={`fixed inset-x-0 bottom-0 z-[1100] flex h-[var(--sheet-h)] flex-col rounded-t-3xl bg-bg shadow-[0_-8px_30px_rgba(15,23,42,0.18)] lg:static lg:h-full lg:rounded-none lg:shadow-none ${
+        dragHeight === null ? 'transition-[height] duration-300 ease-out' : ''
+      }`}
+    >
+      <button
+        type="button"
+        aria-label={snap === 'full' ? 'Kéo hoặc bấm để thu nhỏ khung thông tin' : 'Kéo hoặc bấm để mở rộng khung thông tin'}
+        aria-expanded={snap === 'full'}
+        onPointerDown={onPointerDown}
+        onPointerMove={onPointerMove}
+        onPointerUp={onPointerUp}
+        onPointerCancel={onPointerUp}
+        onClick={onClick}
+        className="flex h-7 shrink-0 cursor-grab touch-none items-center justify-center active:cursor-grabbing lg:hidden"
+      >
+        <span aria-hidden className="h-1.5 w-12 rounded-full bg-line" />
+      </button>
+      <div className="flex min-h-0 flex-1 flex-col gap-5 overflow-y-auto overscroll-contain p-4 pt-1 lg:pt-4 xl:p-5">{children}</div>
+    </aside>
+  )
+}
